{
  // Adapter package — uses the TypeScript compiler API (Node-ish), so it is NOT browser-safe and
  // is intentionally excluded from the runtime-safety guard (like @fairux/html).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Package boundary: every file in this program must live under the package.
    // Reaching into another workspace's src is then a TS6059 error from tsc itself.
    "rootDir": "."
  },
  "include": ["src", "test"]
}
