{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Package boundary: an emit-relevant file resolved into this program must live under the
    // package. Reaching into another workspace's src is then a TS6059 error from tsc itself.
    "rootDir": ".",
    // ★Browser-safety invariant (type layer): no Node/DOM ambient types.
    // Importing `node:*`/`fs`/etc. becomes a type error here, structurally preventing it.
    "types": [],
    "lib": ["ES2022"]
  },
  "include": ["src", "test"]
}
