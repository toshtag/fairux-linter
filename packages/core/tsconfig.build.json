{
  // Declaration-emit program: this package's own sources, nothing else.
  //
  // `tsconfig.json` is the *typecheck* contract (`noEmit`) and deliberately includes `test`.
  // Feeding that same project to tsdown's declaration generator is what caused issue #57: a test
  // importing a sibling package's `src` pulled files outside this package's `rootDir` into the
  // emit program, and tsgo writes out-of-root declarations next to the source instead of into its
  // temp outDir. Scoping the emit program to `src` makes that structurally impossible, whatever a
  // future test happens to import.
  //
  // tsdown drives the real emit and overrides the output directory on the command line. The emit
  // options below keep this project self-consistent, so a hand-run `tsc -p tsconfig.build.json`
  // lands in `dist/` rather than back in `src/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src"]
}
