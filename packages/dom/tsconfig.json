{
  // Browser-only adapter. DOM lib is allowed here (and only here); Node is NOT — the
  // runtime-safety guard forbids Node built-ins in @fairux/dom just like core/rules.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Package boundary: an emit-relevant file resolved into this program must live under the
    // package. Reaching into another workspace's src is then a TS6059 error from tsc itself.
    "rootDir": ".",
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "test"]
}
