{
  "name": "fairux-linter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Rule-based UX linter that detects UI patterns which may distort user decision-making.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck:workspaces": "pnpm -r --if-present typecheck",
    "typecheck:root-tests": "tsc --noEmit -p tsconfig.root-tests.json",
    "typecheck:built": "pnpm typecheck:workspaces && pnpm typecheck:root-tests",
    "typecheck": "pnpm build && pnpm typecheck:built",
    "test:built": "vitest run --passWithNoTests",
    "test": "pnpm --filter \"fairux\" --filter \"@fairux/*\" build && pnpm test:built",
    "test:cli-security": "pnpm --filter \"fairux...\" build && vitest run apps/cli/test/cli-security.test.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:runtime-safety": "node scripts/check-runtime-safety.mjs",
    "check:doc-references": "node scripts/check-doc-references.mjs",
    "check:build-output": "node scripts/check-build-output.mjs",
    "check:third-party-fixtures": "node scripts/check-third-party-fixtures.mjs",
    "third-party:notice": "node scripts/check-third-party-fixtures.mjs --write",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:built && pnpm check:runtime-safety",
    "verify:full": "node scripts/verify-full.mjs",
    "fairux": "node apps/cli/dist/index.js",
    "pack:smoke": "node apps/cli/scripts/pack-smoke-test.mjs",
    "smoke:chrome": "pnpm --filter \"@fairux/chrome-extension...\" build && node apps/chrome-extension/scripts/chrome-host-smoke.mjs",
    "smoke:vscode": "pnpm --filter \"fairux-vscode...\" build && node apps/vscode-extension/scripts/vscode-host-smoke.mjs",
    "pack:smoke:sdk": "node packages/sdk/scripts/pack-smoke-test.mjs",
    "rules:governance:write": "pnpm --filter \"@fairux/rules...\" build && node packages/rules/scripts/generate-reviewed-governance.mjs --write",
    "rules:governance:check:built": "node packages/rules/scripts/generate-reviewed-governance.mjs --check",
    "rules:governance:check": "pnpm --filter \"@fairux/rules...\" build && pnpm rules:governance:check:built",
    "rules:catalog": "pnpm rules:governance:write && pnpm --filter \"@fairux/rules...\" build && node packages/rules/scripts/generate-rule-catalog.mjs --write",
    "rules:catalog:check:built": "pnpm rules:governance:check:built && node packages/rules/scripts/generate-rule-catalog.mjs --check",
    "rules:catalog:check": "pnpm --filter \"@fairux/rules...\" build && pnpm rules:catalog:check:built",
    "rules:reviews:check:built": "node packages/rules/scripts/check-reviews.mjs --baseline packages/rules/reviews/rule-review-baseline.json",
    "rules:reviews:check": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" build && pnpm rules:reviews:check:built",
    "test:rule-pack-author-example": "node scripts/test-rule-pack-author-example.mjs",
    "eval:corpus": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" build && node scripts/evaluate-corpus.mjs",
    "eval:corpus:check:built": "node scripts/evaluate-corpus.mjs --check",
    "eval:corpus:check": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" build && pnpm eval:corpus:check:built",
    "eval:holdout": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" --filter \"@fairux/ast...\" --filter \"@fairux/figma...\" build && node scripts/evaluate-holdout.mjs",
    "calibrate:risk-index": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" build && node scripts/calibrate-risk-index.mjs",
    "calibrate:risk-index:check:built": "node scripts/calibrate-risk-index.mjs --check",
    "calibrate:risk-index:check": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" build && pnpm calibrate:risk-index:check:built",
    "api:inventory": "pnpm --filter \"@fairux/sdk...\" build && node scripts/generate-api-inventory.mjs",
    "api:inventory:check:built": "node scripts/generate-api-inventory.mjs --check",
    "api:inventory:check": "pnpm --filter \"@fairux/sdk...\" build && pnpm api:inventory:check:built",
    "cli:inventory": "node scripts/generate-cli-inventory.mjs",
    "cli:inventory:check": "node scripts/generate-cli-inventory.mjs --check",
    "review:evidence": "node scripts/collect-review-evidence.mjs",
    "release:check:cli": "node apps/cli/scripts/release-check.mjs",
    "release:check:sdk": "node packages/sdk/scripts/release-check.mjs",
    "release:dry-run:cli": "node apps/cli/scripts/release-dry-run.mjs",
    "release:dry-run:sdk": "node packages/sdk/scripts/release-dry-run.mjs",
    "registry:smoke:cli": "node apps/cli/scripts/registry-smoke-test.mjs",
    "registry:smoke:sdk": "node packages/sdk/scripts/registry-smoke-test.mjs",
    "rules:reviews:update": "pnpm --filter \"@fairux/rules...\" --filter \"@fairux/html...\" build && node packages/rules/scripts/update-review-baseline.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^22.18.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "parse5": "^8.0.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.7",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
